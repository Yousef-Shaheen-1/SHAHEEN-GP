# ==============================================================================
# SHAHEEN GROUP — Platform Environment Configuration Template
# NOTE: Do NOT place real production secrets in this file. Copy to .env locally.
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV="development"

# Application URL
# Used for self-referential links, OAuth callbacks, and canonical SEO generation.
APP_URL="https://shaheen-group.com"

# Google Gemini API Key
# Required for server-side AI content assistant generation (case study drafts, SEO, translation).
# Configure in Google AI Studio secrets manager or hosting platform environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Administrative Security Passcode
# Used for server-side administrator session validation.
ADMIN_PASSCODE="your_secure_admin_passcode_here"

# Ambient Audio Asset Path
# Relative or CDN URL pointing to the royalty-free cinematic audio loop.
VITE_AUDIO_TRACK_URL="/assets/audio/shaheen-ambient.mp3"
